{
  "compilerOptions": {
    "target": "es2025",
    "module": "commonjs",
    "lib": ["es2025"],
    "types": ["node"],

    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "sourceMap": false, // fixed
    "declaration": false, // fixed
    "pretty": true,
    "newLine": "lf",
    "stripInternal": true,
    "esModuleInterop": true,
    // Strict Type-Checking options
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": true
  }
}
