{
  "name": "@hq-jp/pages",
  "version": "0.0.0",
  "description": "GCS proxy running on GAE for internal document sharing",
  "private": true,
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "tsx ./src/appengine/main.ts",
    "format": "biome check --write .",
    "gcp-build": "tsc -p .",
    "lint": "biome check .",
    "start": "node ./src/appengine/main.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "express": "^5.3.0",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/express": "^5.0.6",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
